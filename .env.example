# Salin ke .env lalu isi. File .env tidak boleh di-commit.

# API key Google Places API (New). Hanya dipakai di server.
# Saran: batasi key ini di Google Cloud Console ke "Places API (New)" saja.
GOOGLE_PLACES_API_KEY=

# Koneksi Postgres dari docker-compose.yml (task up).
DATABASE_URL=postgres://jaga:jaga@localhost:5433/jagalisting?sslmode=disable

# Batas call ke Google per detik untuk seluruh proses worker (default 1).
PLACES_RPS=1

# Email notifikasi. Default-nya Mailpit dari docker-compose (UI: http://localhost:8025).
# Untuk produksi: server SMTP dengan STARTTLS, biasanya port 587.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Jaga Listing <noreply@jagalisting.local>

# Token bot Telegram dari @BotFather. Kosong = notifikasi Telegram tetap pending.
TELEGRAM_BOT_TOKEN=
